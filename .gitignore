# IDEs / OS
.vscode/
.idea/
*.suo
.DS_Store

# Logs / temp
*.log
*.tmp

# Env (monorepo root safety)
.env
.env.*
!.env.example

# Ops local — não versionar (estratégia de deploy / secrets de produção)
DEPLOY_PROD.local.md

# Tutoriais, planos e notas temporárias (ver .cursor/rules/docs-scratch.mdc)
docs/scratch/

# Dump de produção / cópia local — PII e financeiro; MUST NOT ir pro git
dumps/
backups/
*.dump
*.backup
*.sql.gz
*.pgdump
